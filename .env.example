PORT=3000
DISCORD_ENABLED=true
DISCORD_TOKEN=replace-with-your-discord-bot-token
DISCORD_CLIENT_ID=replace-with-your-discord-application-id

# PostgreSQL / Prisma
DATABASE_ENABLED=true
POSTGRES_DB=discord_bot
POSTGRES_USER=discord_bot
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://discord_bot:replace-with-a-database-password@localhost:5432/discord_bot?schema=public

# User verification
VERIFICATION_CHANNEL_ID=your-verification-channel-id
VERIFIED_ROLE_ID=
VERIFIED_ROLE_NAME=member

# Create a server-side API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Optional: commands register immediately in this server while developing.
# Leave empty to register commands globally instead.
DISCORD_GUILD_ID=

# Login for GET /export-excel (users export with phone/CCCD). Leave both empty
# to disable the endpoint. The password must be at least 12 characters.
EXPORT_USERNAME=
EXPORT_PASSWORD=
