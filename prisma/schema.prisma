generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

model EmailVerification {
  id                  String                  @id @default(uuid()) @db.Uuid
  guildId             String                  @db.VarChar(32)
  discordUserId       String                  @db.VarChar(32)
  email               String?                 @db.VarChar(254)
  emailMasked         String?                 @db.VarChar(254)
  status              EmailVerificationStatus @default(UNVERIFIED)
  otpHash             String?                 @db.Char(64)
  otpExpiresAt        DateTime?
  resendAvailableAt   DateTime?
  attemptsRemaining   Int                     @default(0)
  verifiedAt          DateTime?
  verifiedRoleId      String?                 @db.VarChar(32)
  joinedAt            DateTime                @default(now())
  leftAt              DateTime?
  lastPromptedAt      DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([guildId, discordUserId])
  @@index([status, otpExpiresAt])
  @@map("email_verifications")
}

model User {
  id            Int      @id @default(autoincrement())
  accountName   String   @map("account_name") @db.VarChar(100)
  phone         String   @db.VarChar(32)
  cccd          String   @db.VarChar(32)
  guildId       String   @db.VarChar(32)
  discordUserId String   @db.VarChar(32)
  email         String?  @db.VarChar(254)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("update_at")

  @@unique([guildId, discordUserId])
  @@map("users")
}


enum VerificationPromptDelivery {
  DM
  CHANNEL
}

/// Remembers that a member was already sent the verification button, so the
/// startup scan of existing members does not send it again on every restart.
model VerificationPrompt {
  id            Int                        @id @default(autoincrement())
  guildId       String                     @db.VarChar(32)
  discordUserId String                     @db.VarChar(32)
  deliveredVia  VerificationPromptDelivery @map("delivered_via")
  promptedAt    DateTime                   @default(now()) @map("prompted_at")

  @@unique([guildId, discordUserId])
  @@map("verification_prompts")
}
